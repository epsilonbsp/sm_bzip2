import os

# Name of your extension, this will also be its file name.
projectName = 'bzip2'

# smsdk_ext.cpp will be automatically added later
sourceFiles = [
    'source/extension.cpp',

    # bzip2 library sources
    'build/vendor/bzip2/blocksort.c',
    'build/vendor/bzip2/bzlib.c',
    'build/vendor/bzip2/compress.c',
    'build/vendor/bzip2/crctable.c',
    'build/vendor/bzip2/decompress.c',
    'build/vendor/bzip2/huffman.c',
    'build/vendor/bzip2/randtable.c',
]

project = builder.LibraryProject(projectName)

if os.path.isfile(os.path.join(builder.currentSourcePath, 'sdk', 'smsdk_ext.cpp')):
    # Use the copy included in the project
    project.sources += [os.path.join('sdk', 'smsdk_ext.cpp')]
else:
    # Use the copy included with SM 1.6 and newer
    project.sources += [os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp')]

project.sources += sourceFiles

for sdk_name in Extension.sdks:
    sdk = Extension.sdks[sdk_name]

    if sdk['name'] in ['mock']:
        continue

    for cxx in builder.targets:
        if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
            continue

        binary = Extension.HL2ExtConfig(project, builder, cxx, projectName + '.ext', sdk)

        binary.compiler.cxxincludes += [
            os.path.join(builder.currentSourcePath, 'build', 'vendor', 'bzip2'),
        ]

Extension.extensions += builder.Add(project)
